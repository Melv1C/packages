{
  "extends": "@melv1c/toolchain/tsconfigs/react.json",
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./app/*"],
      "fumadocs-mdx:collections/*": ["./.source/*"]
    },
    "noEmit": true
  }
}
