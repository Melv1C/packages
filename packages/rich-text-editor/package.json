{
  "name": "@melv1c/rich-text-editor",
  "version": "1.0.3",
  "description": "A rich text editor component for React, built with TipTap and styled with Tailwind CSS.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Melv1C/packages.git#main"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean"
  },
  "dependencies": {
    "@tiptap/core": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "lucide-react": "^1.7.0"
  },
  "devDependencies": {
    "@melv1c/toolchain": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "^19.2.3",
    "react": "catalog:",
    "react-dom": "^19.2.4",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@melv1c/ui-core": ">=1.1.3",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0"
  }
}
